<wikidata-pie-chart>
  <pie-chart
    if={state.data}
    size="200px"
    hole-size="50%"
    data={state.data}
  />

  <script>
    import {i18n} from '@wendig/lib'
    import search from '../../lib/wikidata/search'
    import PieChart from '../pie_chart.riot'

    export default class {
      static components = {
        'pie-chart': PieChart
      }

      constructor() {
        this.t = i18n.translate
      }

      onBeforeMount(props, state) {
        search.counts().then(data => {
          this.update({data: {
            [this.t('no_reference')]: {value: data.noRef, color: '#333333'},
            [this.t('wikidata')]: {value: data.wikidata, color: '#eeeeee'}
          }})
        })
      }
    }
  </script>
</wikidata-pie-chart>
